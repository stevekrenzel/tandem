#!/bin/bash
set -euo pipefail

fail() { printf '%s\n' "$*" >&2; exit 1; }
quote() { local value=${1//\'/\'\'}; printf -v literal "'%s'" "$value"; }

rpc() (
  "$@" &
  request=$!
  (
    sleeper=
    trap '
      if [[ -n $sleeper ]]; then
        kill "$sleeper" 2>/dev/null || :
        wait "$sleeper" 2>/dev/null || :
      fi
    ' EXIT
    command -p sleep 10 &
    sleeper=$!
    wait "$sleeper"
    kill -KILL "$request" 2>/dev/null || :
  ) >/dev/null 2>&1 &
  watchdog=$!
  trap '
    kill "$request" "$watchdog" 2>/dev/null || :
    wait "$request" "$watchdog" 2>/dev/null || :
  ' EXIT
  wait "$request"
)

editor=${TANDEM_EDITOR:-}
if [[ -z $editor ]]; then
  editor=neovim
  if [[ -n ${VIM_SERVERNAME:-} && -z ${NVIM:-} ]]; then editor=vim; fi
fi
server=${TANDEM_SERVER:-}
window=${TANDEM_WINDOW:-}
while (($#)); do
  case $1 in
    --editor|--server|--window)
      (($# >= 2)) || fail "Missing value for $1"
      case $1 in
        --editor) editor=$2 ;;
        --server) server=$2 ;;
        --window) window=$2 ;;
      esac
      shift 2 ;;
    -h|--help)
      printf '%s\n' 'Usage: tandem [--editor neovim|vim|macvim] [--server ADDRESS] [--window ID] COMMAND' \
        'Commands: state | read [--start N] [--end N] | show FILE [--line N] [--end N] [--note TEXT]' \
        '          highlight N [--end N] [--note TEXT] | diff [FILE] [--base REV] | clear'
      exit 0 ;;
    *) break ;;
  esac
done
(($#)) || fail 'A command is required. See --help.'
[[ $window =~ ^[0-9]+$ && $window != 0 ]] || fail 'No code window. Start with :Codex or :Claude, or supply --window.'
case $editor in
  neovim)
    server=${server:-${TANDEM_SOCKET:-${NVIM:-}}}
    client=("${TANDEM_NVIM:-nvim}" --server "$server") ;;
  vim|macvim)
    server=${server:-${VIM_SERVERNAME:-}}
    executable=vim
    if [[ $editor == macvim ]]; then executable=mvim; fi
    client=("${TANDEM_VIM:-$executable}" --servername "$server") ;;
  *) fail "Unknown editor: $editor" ;;
esac
[[ -n $server ]] || fail 'No editor connection. Start with :Codex or :Claude, or supply --server.'

# Single-quoted Vim literals preserve arbitrary text without executing it.
expression='tandem#Command(['
for argument in "$@"; do
  quote "$argument"
  expression+="$literal,"
done
quote "$PWD"
expression+="],$literal,"
quote "$window"
expression+="$literal)"
response=$(rpc "${client[@]}" --remote-expr "$expression") || fail 'Editor RPC failed or timed out. Check the connection and plugin installation.'
status=${response%%$'\n'*}
[[ $status == 0 || $status == 1 ]] || fail 'Unexpected editor response. Update the plugin and restart the editor.'
printf '%s\n' "${response#*$'\n'}"
exit "$status"
