#!/usr/bin/env bash
# Lets a coding agent read and drive the user's editor. :Claude and :Codex set
# TANDEM_EDITOR, TANDEM_SERVER, and TANDEM_WINDOW for the agent.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: tandem [--editor neovim|vim|macvim] [--server ADDRESS] [--window ID] COMMAND

Commands:
  state                                          Windows, layout, cursor, open buffers, unsaved changes
  read [FILE] [--start N] [--end N]              Live text, including unsaved edits (80 lines)
  show FILE [--start N] [--end N] [--note TEXT]  Open a file in the code window
  highlight --start N [--end N] [--note TEXT]    Highlight lines of the code window's file
  diff [FILE] [--base REV]                       Compare with a Git revision (default: HEAD)
  clear                                          Remove highlights and the comparison
  ex COMMAND                                     Run any Ex command in the code window, as if typed after :
USAGE
}

fail() { printf 'tandem: %s\n' "$*" >&2; exit 1; }

# Quotes a value as a Vim string literal, in which only '' is special.
# printf -v, unlike $(...), keeps trailing newlines.
quote() { local value=${1//\'/\'\'}; printf -v literal "'%s'" "$value"; }

# Runs a command and kills it if the editor does not answer in time. The
# watchdog's sleep runs in its own subshell so that it can be stopped too.
rpc() (
  "$@" &
  request=$!
  (
    sleeper=
    trap '
      if [[ -n $sleeper ]]; then
        kill "$sleeper" 2>/dev/null || :
        wait "$sleeper" 2>/dev/null || :
      fi
    ' EXIT
    command -p sleep "$timeout" &
    sleeper=$!
    wait "$sleeper"
    kill -KILL "$request" 2>/dev/null || :
  ) >/dev/null 2>&1 &
  watchdog=$!
  trap '
    kill "$request" "$watchdog" 2>/dev/null || :
    wait "$request" "$watchdog" 2>/dev/null || :
  ' EXIT
  wait "$request"
)

editor=${TANDEM_EDITOR:-}
if [[ -z $editor ]]; then
  editor=neovim
  if [[ -n ${VIM_SERVERNAME:-} && -z ${NVIM:-} ]]; then editor=vim; fi
fi
server=${TANDEM_SERVER:-}
# Session keys normally match a starting window ID; reused windows get a
# negative key so they cannot take over an existing session.
window=${TANDEM_WINDOW:-}
timeout=${TANDEM_TIMEOUT:-10}
while (($#)); do
  case $1 in
    --editor|--server|--window)
      (($# >= 2)) || fail "Missing value for $1."
      case $1 in
        --editor) editor=$2 ;;
        --server) server=$2 ;;
        --window) window=$2 ;;
      esac
      shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) break ;;
  esac
done
(($#)) || { usage >&2; exit 1; }
[[ $timeout =~ ^[0-9]+$ && $timeout != 0 ]] || fail 'TANDEM_TIMEOUT must be a positive number of seconds.'
[[ $window =~ ^-?[0-9]+$ && $window != 0 ]] || fail 'No code window. Start the agent with :Claude or :Codex, or pass --window.'
# The editor's own binary is the surest client, unless an upgrade removed it.
binary=${TANDEM_EDITOR_BIN:-}
case $editor in
  neovim)
    server=${server:-${NVIM:-}}
    [[ -x $binary ]] || binary=nvim
    client=("$binary" --server "$server") ;;
  vim|macvim)
    server=${server:-${VIM_SERVERNAME:-}}
    if [[ ! -x $binary ]]; then
      binary=vim
      if [[ $editor == macvim ]]; then binary=mvim; fi
    fi
    client=("$binary" --servername "$server") ;;
  *) fail "Unknown editor: $editor." ;;
esac
[[ -n $server ]] || fail 'No editor connection. Start the agent with :Claude or :Codex, or pass --server.'

expression='tandem#Command(['
for argument in "$@"; do
  quote "$argument"
  expression+="$literal,"
done
quote "$PWD"
expression+="],$literal,"
quote "$window"
expression+="$literal)"

status=0
response=$(rpc "${client[@]}" --remote-expr "$expression") || status=$?
if ((status == 137)); then
  fail "The editor did not answer within ${timeout}s; it may be waiting for input. Try again."
elif ((status != 0)) || [[ -z $response ]]; then
  # Vim's client exits 0 when it cannot connect.
  fail "Could not reach the editor at $server. If this shell is sandboxed, rerun the same command" \
    'with permission to run outside the sandbox. Otherwise ask the user to restart :Claude or :Codex.'
fi
code=${response%%$'\n'*}
[[ $code == 0 || $code == 1 ]] || fail 'Unexpected editor response. Is the Tandem plugin loaded? Restart the editor after updating it.'
printf '%s\n' "${response#*$'\n'}"
exit "$code"
